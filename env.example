# WebSafe — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in YOUR OWN keys.
#
#   cp env.example .env        (Mac/Linux)
#   copy env.example .env      (Windows)
#
# NEVER commit .env to source control — it contains your real secrets.
# NEVER put real keys in this file — env.example IS committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Threat intelligence APIs ──────────────────────────────────────────────────

# Google Safe Browsing v4 API key
# Get free key: https://developers.google.com/safe-browsing/v4/get-started
GSB_KEY=your_google_safe_browsing_key_here

# VirusTotal Public API key
# Sign up: https://www.virustotal.com/gui/join-us
VT_KEY=your_virustotal_key_here

# urlscan.io API key
# Sign up: https://urlscan.io/user/signup
URLSCAN_KEY=your_urlscan_key_here

# CheckPhish API key (by Bolster)
# Sign up: https://developers.checkphish.ai/
CHECKPHISH_KEY=your_checkphish_key_here

# ── Chat assistant ────────────────────────────────────────────────────────────

# Google Gemini API key
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server configuration ──────────────────────────────────────────────────────

PORT=3000

# Set to "production" on your hosting platform
NODE_ENV=development

# REQUIRED in production — set to your deployed domain(s)
# Example: https://websafe.yourdomain.com
ALLOWED_ORIGINS=
